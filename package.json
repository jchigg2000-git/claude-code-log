{
  "name": "claude-code-log",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local dashboard for browsing Claude Code history across all your repos.",
  "scripts": {
    "dev": "vite",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fixtures": "node scripts/make-fixtures.mjs",
    "demo": "npm run fixtures && VITE_LOG_DIR=\"$PWD/fixtures/projects\" VITE_REPO_ROOT=\"$PWD/fixtures/repos\" vite",
    "screenshots": "node scripts/make-screenshots.mjs"
  },
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
